{
  "name": "rta-hub",
  "version": "0.1.0",
  "description": "RTA-Hub — 多租户橱柜设计与报价市场平台（基于 @meso.ai/let-it-flow 构建）",
  "type": "module",
  "license": "MIT",
  "author": "Grant-Huang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grant-Huang/rta-hub.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "npm --prefix web-ui run dev",
    "build": "tsc -p tsconfig.build.json",
    "build:ui": "npm --prefix web-ui run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ops:prospects": "tsx src/ops/prospects-cli.ts",
    "gates": "tsx src/ops/gates-cli.ts",
    "simulate": "tsx scripts/simulate.mts",
    "simulate:supply": "tsx scripts/simulate-supply.mts",
    "test:user": "tsx scripts/run-test-user.mts",
    "sanity:doc": "tsx scripts/sanity-doc.mts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@meso.ai/let-it-flow": "^0.3.2",
    "ai": "^6.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.0",
    "nodemailer": "^6.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
