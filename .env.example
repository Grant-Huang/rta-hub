# ── 服务 ──────────────────────────────────────────────────────────────────
PORT=8790
# 数据目录（平面文件持久化）
DATA_DIR=./data
# 运营端点的令牌。**留空则全部运营端点一律拒绝**，不设默认口令。
ADMIN_TOKEN=

# 访问控制阶段（admin 对跨厂 L1 的写权限）。见 docs/ACCESS_CONTROL.md §3.2。
#   design      → admin / 代公司可读写任意公司 L1（本地默认）
#   production  → admin 可读任意公司 L1，禁止写
# 留空时：NODE_ENV=production → production，否则 design。
# 别名：RTA_STAGE
ACCESS_STAGE=

# ── 整站访问口令（对外暴露前必须设置）──────────────────────────────────────
# 外层闸门：把整个站挡在一个共享口令后面。
#
# 它**不是**登录态，也不替代 E1——口令后面的人仍可互相冒充账号（X-Account-Id
# 头目前不做校验）。它解决的是"谁能碰到这个系统"。
#
# 规则：
#   配了               → 启用
#   没配 + 非生产      → 不启用，但每次启动打印警告
#   没配 + NODE_ENV=production → **拒绝启动**
#
# 最后一条是刻意的：让配置失误变成一次启动失败，而不是一次数据泄露。
SITE_PASSWORD=
# 会话 cookie 的签名密钥。留空则从口令派生（换口令即踢掉所有人）。
SESSION_SECRET=
# 逃生口：确实要开放公网访问时显式设置为 true。
SITE_PASSWORD_DISABLED=
# 条款版本号，写入订阅与账号的同意记录（变更用途时需递增并重新取得同意）
TERMS_VERSION=2026-01
BASE_URL=http://localhost:8790

# GenericCatalog 的价格区间来源是否已核实。
# 未设为 true 时，EstimateDraft 的免责声明会如实标注为「未经核实的占位数据」。
# 见 PRE_LAUNCH_CHECKLIST A4 / 开放问题 5。
GENERIC_CATALOG_VERIFIED=false

# 线索费（加元），对应 LeadBillingEvent.feeAmount
# 注意：费率尚未定案，见 REQUIREMENTS 第 12 节开放问题 6
LEAD_FEE_CAD=45.00

# ── LLM ──────────────────────────────────────────────────────────────────
# 留空时对话降级为确定性引导问答，报价/闸门/计费等核心链路不受影响。

# 主模型（轻量/对话）- OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 模型分层（见 docs/LLM_ARCHITECTURE.md）。
#   轻量层跑 90% 的对话轮次；主力层只在确定性触发时上场；视觉层读户型图。
#   回退规则：轻量缺→用主力（只是贵）；主力缺→用轻量（会警告准确度下降）；
#   视觉缺→**不回退**，户型录入降级为手动（文本模型看不了图）。
# DeepSeek 官方 API 仅接受：deepseek-v4-flash（轻量）/ deepseek-v4-pro（主力）
# 旧名 deepseek-chat / deepseek-reasoner / deepseek-reasoning 已失效。
LLM_MODEL_CHAT=deepseek-v4-flash
LLM_MODEL_REASONING=deepseek-v4-pro
LLM_MODEL_VISION=qwen2.5vl
# 文本 LLM 超时（毫秒）。超时后会话仍落盘需求，并返回可读错误，避免前端只显示 (no response)
LLM_TIMEOUT_MS=60000

# 视觉模型专用配置（Ollama，本地无需 key）
OPENAI_API_KEY_VISION=
OPENAI_BASE_URL_VISION=http://localhost:11434
# 单模型部署的向后兼容：只配这个就三层里的两层文本层都用它
OPENAI_MODEL=

# ── 测试用户 / pnpm simulate 专用 LLM（不影响上面的生产配置）──────────────
# 默认本机 Ollama。用户 agent 对话用 14b；场景 JSON 用 reasoning；户型视觉用 vl。
OPENAI_API_KEY_TEST=ollama
OPENAI_BASE_URL_TEST=http://localhost:11434/v1
OPENAI_BASE_URL_TEST_VISION=http://localhost:11434
LLM_MODEL_TEST_CHAT=qwen2.5:14b-instruct
LLM_MODEL_TEST_REASONING=qwen2.5:14b-instruct
LLM_MODEL_TEST_VISION=qwen2.5vl:latest

# ── DesignCritic 专用（无 chat；reasoning=DeepSeek，vision=Qwen VL）────────
# 未设 OPENAI_API_KEY_CRITIC 时复用生产 OPENAI_API_KEY / BASE_URL。
OPENAI_API_KEY_CRITIC=
OPENAI_BASE_URL_CRITIC=
LLM_MODEL_CRITIC_REASONING=deepseek-v4-pro
OPENAI_BASE_URL_CRITIC_VISION=http://localhost:11434/v1
OPENAI_API_KEY_CRITIC_VISION=ollama
LLM_MODEL_CRITIC_VISION=qwen2.5vl:latest

# ── 上线闸门（见 docs/LAUNCH_BLOCKERS.md）──────────────────────────────────
# 取值是**核实日期** YYYY-MM-DD，不是 true —— 核实过不等于永远有效，
# 税率会变、NKBA 指南有修订历史，所以核实有保质期。
#
# NODE_ENV=production 时，未核实的阻断项会让服务**拒绝启动**。
# 用 `pnpm gates` 随时查看当前状态（有阻断项时退出码为 1，可做部署门禁）。
# A1/A2：对照 CRA 税率表 + QC 2012-4 公报后填写（见 LAUNCH_BLOCKERS §3）
VERIFIED_TAX_RATES=2026-08-08
# A6：对照公开 NKBA Kitchen Planning Guidelines PDF 后填写核实日期（YYYY-MM-DD）
VERIFIED_NKBA_CLEARANCES=2026-08-08
VERIFIED_AUTH_MODEL=
VERIFIED_LEAD_FEE=
VERIFIED_GENERIC_CATALOG=
# B6：留存 cron /admin retention/run 接线后填写核实日期
VERIFIED_RETENTION_CRON=2026-08-08
# 留存清除间隔（毫秒）。未设或 0 = 不自动跑；例：86400000 = 每天
RETENTION_CRON_MS=
# 明知故犯的逃生口：逐项写 id（如 A6,G4），不能一把全关
LAUNCH_GATES_ACKNOWLEDGED=

# ── 运营工具：公司发现（FR-12，手动触发）─────────────────────────────────
# 搜索 provider（可选；留空则回退 DuckDuckGo native provider）
TAVILY_API_KEY=
# 公司发现库的平面文件位置
PROSPECTS_FILE=./data/companies.json

# ── SMTP ─────────────────────────────────────────────────────────────────
# 任一为空即进入 dry-run 预览模式，不会发出任何邮件（发送闸门的第二道防线）。
# 第一道防线是服务端状态机：报价必须先由客户确认（Quote.status = confirmed）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 发信身份（出现在邮件正文里；CASL 要求发件人身份透明）
SENDER_NAME=
SENDER_PHONE=
