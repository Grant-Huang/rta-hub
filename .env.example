# LLM（必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 搜索 provider（可选；留空则回退 DuckDuckGo native provider）
TAVILY_API_KEY=

# 服务端口
CABINET_QUOTES_PORT=8790

# 发信身份（出现在询价邮件正文里）
CABINET_SENDER_NAME=
CABINET_SENDER_PHONE=

# SMTP —— 任一为空即进入 dry-run 预览模式，不会发出任何邮件
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
