# ── 服务 ──────────────────────────────────────────────────────────────────
PORT=8790
# 数据目录（平面文件持久化）
DATA_DIR=./data
# 运营端点的令牌。**留空则全部运营端点一律拒绝**，不设默认口令。
ADMIN_TOKEN=
# 条款版本号，写入订阅与账号的同意记录（变更用途时需递增并重新取得同意）
TERMS_VERSION=2026-01
BASE_URL=http://localhost:8790

# GenericCatalog 的价格区间来源是否已核实。
# 未设为 true 时，EstimateDraft 的免责声明会如实标注为「未经核实的占位数据」。
# 见 PRE_LAUNCH_CHECKLIST A4 / 开放问题 5。
GENERIC_CATALOG_VERIFIED=false

# 线索费（加元），对应 LeadBillingEvent.feeAmount
# 注意：费率尚未定案，见 REQUIREMENTS 第 12 节开放问题 6
LEAD_FEE_CAD=45.00

# ── LLM ──────────────────────────────────────────────────────────────────
# 留空时对话降级为确定性引导问答，报价/闸门/计费等核心链路不受影响。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 运营工具：公司发现（FR-12，手动触发）─────────────────────────────────
# 搜索 provider（可选；留空则回退 DuckDuckGo native provider）
TAVILY_API_KEY=
# 公司发现库的平面文件位置
PROSPECTS_FILE=./data/companies.json

# ── SMTP ─────────────────────────────────────────────────────────────────
# 任一为空即进入 dry-run 预览模式，不会发出任何邮件（发送闸门的第二道防线）。
# 第一道防线是服务端状态机：报价必须先由客户确认（Quote.status = confirmed）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 发信身份（出现在邮件正文里；CASL 要求发件人身份透明）
SENDER_NAME=
SENDER_PHONE=
